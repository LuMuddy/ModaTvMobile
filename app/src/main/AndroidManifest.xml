<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- REQUEST_INSTALL_PACKAGES 是应用内自助更新的硬前提：API 26+ 起系统不再提供
         全局「未知来源」开关，装 APK 的权限按应用逐个授予，清单里没声明这个权限时
         startActivity(ACTION_VIEW, apk) 会被系统直接拒绝——用户连去设置里打开的机会都没有。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 崩溃日志要落到 /sdcard/crash（用户指定的位置）。
         这个权限从 Android 10 起就只剩「legacy 模式」一条路，Android 11+ 申请也拿不到：
         所以清单里保留它（老设备直接可用、个别宽松 ROM 在 11 上也还会给），
         运行时申请只在能真的授予的版本上发起；写不进去时由 CrashLog 自动退到
         /sdcard/Android/data/<包名>/files/crash。崩溃页显示的是实际落点。 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android 11 起，写 /sdcard/crash 只剩这一条路：WRITE_EXTERNAL_STORAGE 对
         targetSdk >= 30 恒为拒绝，而 MANAGE_EXTERNAL_STORAGE（「所有文件访问」）不是运行时权限，
         只能由用户在系统设置页里手动打开，所以启动时的引导弹窗 + 这里声明缺一不可。
         没有它时日志会落到 /sdcard/Android/data/<包名>/files/crash（见 crash/CrashLog.kt）。 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- 与 TV 端的差异：这里没有 android.software.leanback 的 uses-feature。
         电视端靠它声明运行环境，手机端留着会让部分应用商店把包判成电视专用包。 -->

    <application
        android:name=".ModaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.Moda">

        <!-- 主 Activity 不写 android:screenOrientation：竖屏是默认形态，
             播放页由运行时（PlayerScreen）切横屏、退出时切回，写死在清单里就锁不回竖屏了。
             configChanges 自行吞掉旋转/深色模式切换，避免旋转一次就重建 Activity
             把正在播放的播放器、滚动位置一起丢掉。resizeableActivity 保持默认（true）。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <!-- 手机端只有桌面入口一个 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 崩溃页跑在独立进程 :crash 里，这是「主线程崩了还能看见界面」的唯一办法：
             主线程崩溃时本进程的 Looper 已经死了，同进程里再起 Activity 不会有界面。
             taskAffinity 另开一条任务 + excludeFromRecents：崩溃页不压在崩溃那条任务上，
             用户关掉它不会又被送回那个已死进程的旧页面，最近任务列表里也不会多出一张崩溃卡片。
             进程名必须与 CrashHandler.CRASH_PROCESS_SUFFIX（":crash"）保持一致。 -->
        <activity
            android:name=".crash.CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:taskAffinity="com.moda.mobile.crash"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />

        <!-- 安装器读不到本应用的 cacheDir，只能用 content:// 递一个临时读权限过去。
             exported=false：别的应用不能主动来拿；grantUriPermissions=true 才是给安装器的授权方式，
             范围由 file_paths.xml 限定为 cache/update/ 一个子目录。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
