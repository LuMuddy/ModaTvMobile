<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- REQUEST_INSTALL_PACKAGES 是应用内自助更新的硬前提：API 26+ 起系统不再提供
         全局「未知来源」开关，装 APK 的权限按应用逐个授予，清单里没声明这个权限时
         startActivity(ACTION_VIEW, apk) 会被系统直接拒绝——用户连去设置里打开的机会都没有。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 与 TV 端的差异：这里没有 android.software.leanback 的 uses-feature。
         电视端靠它声明运行环境，手机端留着会让部分应用商店把包判成电视专用包。 -->

    <application
        android:name=".ModaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Moda">

        <!-- 主 Activity 不写 android:screenOrientation：竖屏是默认形态，
             播放页由运行时（PlayerScreen）切横屏、退出时切回，写死在清单里就锁不回竖屏了。
             configChanges 自行吞掉旋转/深色模式切换，避免旋转一次就重建 Activity
             把正在播放的播放器、滚动位置一起丢掉。resizeableActivity 保持默认（true）。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <!-- 手机端只有桌面入口一个 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 安装器读不到本应用的 cacheDir，只能用 content:// 递一个临时读权限过去。
             exported=false：别的应用不能主动来拿；grantUriPermissions=true 才是给安装器的授权方式，
             范围由 file_paths.xml 限定为 cache/update/ 一个子目录。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
