<?xml version="1.0" encoding="utf-8"?>
<!-- 只暴露实际需要递出去的两类目录，不用 root-path / external-path 的宽泛形式。
     1. cache/update/：安装包放在这里，安装器拿到的 URI 只能落在这一层；
     2. Download/：设置页「上报崩溃」打好的 <时间戳>.zip 在这里，
        系统分享面板要把 content:// 交给第三方应用读——对方没有文件系统读权限，
        只能通过这个 provider 拿（见 ui/CrashReportAction.kt 的 share()）。
        第二项是公共下载目录，只在 Android 11+ 拿到「所有文件访问」后才能真正读到；
        读不到时压缩包会落在应用自己的 Download 目录，路径同样由 external-files-path 覆盖。 -->
<paths>
    <cache-path name="update" path="update/" />
    <external-path name="public_download" path="Download/" />
    <external-files-path name="app_download" path="Download/" />
</paths>
