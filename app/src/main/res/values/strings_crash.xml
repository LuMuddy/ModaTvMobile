    <string name="m_crash_path">日志位置</string>
    <string name="m_crash_path_unavailable">未能写入文件</string>
    <string name="m_crash_detail">崩溃详情</string>
    <string name="m_crash_copy">复制日志</string>
    <string name="m_crash_copied">已复制</string>
    <string name="m_crash_restart">重新打开</string>
    <string name="m_crash_close">关闭</string>
    <string name="m_crash_empty">没有读到崩溃内容</string>
