<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页「上报崩溃」的文案。
     与 strings_crash.xml（崩溃页，跑在 :crash 进程）分开：这一份是主进程设置页的，
     两处的显示时机、改动理由都不同，混在一个文件里迟早会改错地方。
     两处都同时给出「文件名」和「完整路径」：用户既要在分享面板里认清是哪个文件，
     也要能在文件管理器里找到它（压缩包可能被保留下来，路径是唯一的凭据）。 -->
<resources>
    <string name="m_crash_report_row_title">上报崩溃</string>
    <!-- 只在真的存在崩溃日志时这一行才出现，值直接说清有多少个 -->
    <string name="m_crash_report_row_value">%1$d 个日志</string>
    <string name="m_crash_report_share_title">分享崩溃日志</string>
    <string name="m_crash_report_failed">打包失败，请稍后重试</string>
    <string name="m_crash_report_share_failed">没有可以接收压缩包的应用</string>

    <!-- 打包完成：先把文件名与路径亮出来，再进系统分享面板 -->
    <string name="m_crash_report_packed_title">打包完成</string>
    <string name="m_crash_report_packed_body">文件名：%1$s\n路径：%2$s\n\n点「分享」把压缩包发出去。</string>
    <string name="m_crash_report_share">分享</string>
    <string name="m_crash_report_cancel">取消</string>

    <!-- 分享回来问删除：必须提醒"等对方收完再删"，否则对方拿到的是被删掉的文件 -->
    <string name="m_crash_report_ask_title">分享完成</string>
    <string name="m_crash_report_ask_body">文件名：%1$s\n路径：%2$s\n\n请等对方上传或接收完成后再删除；现在就删可能让对方拿到一个空文件。</string>
    <string name="m_crash_report_delete">删除</string>
    <string name="m_crash_report_keep">保留</string>
    <string name="m_crash_report_error_title">上报崩溃</string>
    <string name="m_crash_report_error_ok">好</string>
</resources>
